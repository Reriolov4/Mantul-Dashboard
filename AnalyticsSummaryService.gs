/** MANTUL DASHBOARD — DERIVED ANALYTICS READ MODELS */
const ANALYTICS_SUMMARY_STATUS_KEY_='MANTUL_DERIVED_INDEX_STATUS';
const ANALYTICS_SUMMARY_STATS_KEY_='MANTUL_DERIVED_INDEX_STATS';
const P2_DASHBOARD_HEADERS_=P2_EVENT_HEADERS_.concat(['SOURCE_ROWS']);
const P3_OUTLET_HEADERS_=['YEAR','MONTH','CUSTOMER_NAME','SUBDIST','VAL','CARTON'];
function analyticsSummaryReady_(){if(PropertiesService.getScriptProperties().getProperty(ANALYTICS_SUMMARY_STATUS_KEY_)!=='COMPLETE')return false;const ss=getDatabase_(),a=ss.getSheetByName('P2_DASHBOARD_FACT'),b=ss.getSheetByName('P3_OUTLET_MONTHLY');return !!(a&&a.getLastRow()>1&&b&&b.getLastRow()>1);}
function analyticsGetSourceStats_(){if(!analyticsSummaryReady_())return null;try{return JSON.parse(PropertiesService.getScriptProperties().getProperty(ANALYTICS_SUMMARY_STATS_KEY_)||'null');}catch(e){return null;}}
function analyticsBuildDashboardIndexes(){const lock=LockService.getScriptLock();lock.waitLock(30000);const props=PropertiesService.getScriptProperties();props.setProperty(ANALYTICS_SUMMARY_STATUS_KEY_,'BUILDING');try{const t=Date.now(),ss=getDatabase_(),src=ss.getSheetByName('P2_EVENT_INDEX');if(!src||src.getLastRow()<2)throw Error('P2_EVENT_INDEX belum berisi transaksi.');const actual=src.getRange(1,1,1,16).getDisplayValues()[0].map(page2HeaderKey_);if(!P2_EVENT_HEADERS_.every((x,i)=>page2HeaderKey_(x)===actual[i]))throw Error('Header P2_EVENT_INDEX tidak sesuai 16 kolom: '+actual.join(' | '));const raw=src.getRange(2,1,src.getLastRow()-1,16).getValues(),stats=analyticsCountSourceRows_(raw),p2=analyticsAggregateP2Rows_(raw),p3=analyticsAggregateP3Rows_(raw);analyticsWriteSheetAtomic_(ss,'P2_DASHBOARD_FACT',P2_DASHBOARD_HEADERS_,p2);analyticsWriteSheetAtomic_(ss,'P3_OUTLET_MONTHLY',P3_OUTLET_HEADERS_,p3);Object.assign(stats,{sourceRowCount:raw.length,p2SummaryRows:p2.length,p3SummaryRows:p3.length,builtAt:new Date().toISOString(),sourceLastRow:src.getLastRow()});props.setProperty(ANALYTICS_SUMMARY_STATS_KEY_,JSON.stringify(stats));props.setProperty(ANALYTICS_SUMMARY_STATUS_KEY_,'COMPLETE');const result={ok:true,status:'COMPLETE',sourceRows:raw.length,p2SummaryRows:p2.length,p3SummaryRows:p3.length,elapsedMs:Date.now()-t,stats:stats};Logger.log('ANALYTICS BUILD RESULT\\n'+JSON.stringify(result,null,2));console.log('ANALYTICS BUILD RESULT',result);return result;}catch(e){props.setProperty(ANALYTICS_SUMMARY_STATUS_KEY_,'FAILED');Logger.log('ANALYTICS BUILD FAILED: '+(e&&e.stack||e));console.error('ANALYTICS BUILD FAILED',e);throw e;}finally{lock.releaseLock();}}
function analyticsCountSourceRows_(rows){const salesTypeCounts={},teamCounts={};rows.forEach(r=>{const t=page2Key_(r[11]),u=page2Key_(r[13]);if(t)salesTypeCounts[t]=(salesTypeCounts[t]||0)+1;if(u)teamCounts[u]=(teamCounts[u]||0)+1;});return {salesTypeCounts:salesTypeCounts,teamCounts:teamCounts};}
function analyticsAggregateP2Rows_(rows){const map=new Map();rows.forEach(r=>{if(page2Key_(r[11])!=='SOO')return;const k=JSON.stringify(r.slice(0,14));let x=map.get(k);if(!x){x=r.slice(0,16);x[14]=0;x[15]=0;x[16]=0;map.set(k,x);}x[14]+=Number(r[14])||0;x[15]+=Number(r[15])||0;x[16]++;});return Array.from(map.values());}
function analyticsAggregateP3Rows_(rows,yf,mf){const map=new Map();rows.forEach(r=>{if(page2Key_(r[11])!=='SOO'||page2Key_(r[13])!=='SALESMAN')return;const y=page3Year_(r[0]),m=page3Month_(r[1]),c=page2Text_(r[4]),s=page2Text_(r[5]);if(!y||!m||!c||(yf&&y!==Number(yf))||(mf&&m!==mf))return;const k=JSON.stringify([y,m,c,s]);let x=map.get(k);if(!x){x=[y,m,c,s,0,0];map.set(k,x);}x[4]+=Number(r[14])||0;x[5]+=Number(r[15])||0;});return Array.from(map.values());}
function analyticsWriteSheetAtomic_(ss,name,headers,rows){const id=Utilities.getUuid().replace(/-/g,'').slice(0,8),tmp=(name+'_BUILD_'+id).slice(0,99),bak=(name+'_OLD_'+id).slice(0,99),sh=ss.insertSheet(tmp);let old=null,renamed=false;try{ensureSheetGrid_(sh,Math.max(1,rows.length+1),headers.length);sh.getRange(1,1,1,headers.length).setValues([headers]);if(rows.length)sh.getRange(2,1,rows.length,headers.length).setValues(rows);sh.setFrozenRows(1);old=ss.getSheetByName(name);if(old){old.setName(bak);renamed=true;}sh.setName(name);if(renamed)ss.deleteSheet(old);}catch(e){try{if(renamed&&ss.getSheetByName(bak)&&!ss.getSheetByName(name))ss.getSheetByName(bak).setName(name);}catch(x){}try{const q=ss.getSheetByName(tmp);if(q)ss.deleteSheet(q);}catch(x){}throw e;}}
function analyticsDeleteSummaryPeriod_(sh,y,m){const n=sh.getLastRow()-1;if(n<=0)return 0;const a=sh.getRange(2,1,n,2).getValues(),blocks=[];let st=-1,c=0;for(let i=0;i<a.length;i++){const ok=Number(a[i][0])===Number(y)&&page2Month_(a[i][1])===page2Month_(m);if(ok){if(st<0)st=i+2;c++;}else if(st>=0){blocks.push([st,c]);st=-1;c=0;}}if(st>=0)blocks.push([st,c]);blocks.sort((a,b)=>b[0]-a[0]).forEach(x=>sh.deleteRows(x[0],x[1]));return blocks.reduce((s,x)=>s+x[1],0);}
function analyticsUpdateDashboardPeriod_(y,m,rows){if(!analyticsSummaryReady_())return {updated:false,reason:'Initial derived index belum dibangun.'};const ss=getDatabase_(),a=ss.getSheetByName('P2_DASHBOARD_FACT'),b=ss.getSheetByName('P3_OUTLET_MONTHLY'),p2=analyticsAggregateP2Rows_(rows||[]),p3=analyticsAggregateP3Rows_(rows||[],y,m);analyticsDeleteSummaryPeriod_(a,y,m);analyticsDeleteSummaryPeriod_(b,y,m);if(p2.length){const r=a.getLastRow()+1;ensureSheetGrid_(a,r+p2.length-1,P2_DASHBOARD_HEADERS_.length);a.getRange(r,1,p2.length,P2_DASHBOARD_HEADERS_.length).setValues(p2);}if(p3.length){const r=b.getLastRow()+1;ensureSheetGrid_(b,r+p3.length-1,P3_OUTLET_HEADERS_.length);b.getRange(r,1,p3.length,P3_OUTLET_HEADERS_.length).setValues(p3);}analyticsRefreshSourceStats_();return {updated:true,p2Rows:p2.length,p3Rows:p3.length};}
function analyticsRefreshSourceStats_(){const ss=getDatabase_(),sh=ss.getSheetByName('P2_EVENT_INDEX');if(!sh||sh.getLastRow()<2)return null;const a=sh.getRange(2,12,sh.getLastRow()-1,3).getValues(),salesTypeCounts={},teamCounts={};a.forEach(r=>{const t=page2Key_(r[0]),u=page2Key_(r[2]);if(t)salesTypeCounts[t]=(salesTypeCounts[t]||0)+1;if(u)teamCounts[u]=(teamCounts[u]||0)+1;});const stats={sourceRowCount:sh.getLastRow()-1,salesTypeCounts:salesTypeCounts,teamCounts:teamCounts,p2SummaryRows:ss.getSheetByName('P2_DASHBOARD_FACT').getLastRow()-1,p3SummaryRows:ss.getSheetByName('P3_OUTLET_MONTHLY').getLastRow()-1,builtAt:new Date().toISOString()};PropertiesService.getScriptProperties().setProperty(ANALYTICS_SUMMARY_STATS_KEY_,JSON.stringify(stats));return stats;}
function analyticsGetDashboardIndexStatus(){const result={ready:analyticsSummaryReady_(),status:PropertiesService.getScriptProperties().getProperty(ANALYTICS_SUMMARY_STATUS_KEY_)||'NOT_BUILT',stats:analyticsGetSourceStats_()};Logger.log('ANALYTICS INDEX STATUS\\n'+JSON.stringify(result,null,2));console.log('ANALYTICS INDEX STATUS',result);return result;}
